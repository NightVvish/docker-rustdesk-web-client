# Copiez ce fichier vers .env. Docker Compose et build.sh le chargeront.

# Image et conteneur locaux
IMAGE_NAME=rustdesk-web-client
CONTAINER_NAME=rustdesk-web-client
WEB_PORT=5000

# Backend RustDesk utilisé par le proxy Nginx.
# Indiquer uniquement un nom d'hôte ou une adresse IP, sans schéma ni port.
BACKEND_HOST=127.0.0.1
PROTO=http

# Source du client web
RUSTDESK_REPO=MonsieurBiche/rustdesk-web-client
RUSTDESK_TAG=fix-build
RUSTDESK_COMMIT=
RUSTDESK_EXPECTED_COMMIT=525b5e561faf824850c71500adf463e4e0a504d4
ENABLE_WSS=true
FLUTTER_VERSION=3.22.1
RUST_VERSION=1.97.0

# Pour une autre branche ou un autre dépôt, adaptez RUSTDESK_REPO et
# RUSTDESK_TAG. RUSTDESK_COMMIT peut rester vide ou contenir le SHA à verrouiller.
# Exemples:
# RUSTDESK_TAG=enable-wss
# RUSTDESK_TAG=add-features
# RUSTDESK_REPO=rustdesk/rustdesk
# RUSTDESK_TAG=1.4.0
